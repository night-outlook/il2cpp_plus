+    // Identity validity does not imply permission to enter business code.
+    // Check the latched cause as well as state: first-cause publication precedes
+    // the release-store of the terminal state in guard rejection paths.
+    bool HasTerminalExecutionFailure() noexcept
+    {
+        const auto state = s_state.load(std::memory_order_acquire);
+        return state == AssemblyShadowState::Failed || state == AssemblyShadowState::FailedAfterCommit ||
+            s_typeFailure.load(std::memory_order_acquire) || s_unexpectedFailure.load(std::memory_order_acquire);
+    }
+
+    bool TerminalMethodEntryAllowed(const MethodInfo* method, const MethodInfo* definition) noexcept
+    {
+        if (!HasTerminalExecutionFailure()) return true;
+        const auto* configuration = s_configuration.load(std::memory_order_acquire);
+        const auto* candidates = s_candidates.load(std::memory_order_acquire);
+        if (!configuration || !method || !definition) return false;
+        // Only explicitly configured physical stable AOT owners can keep the
+        // fixed diagnostic/exception path alive. Names or remapped owners alone
+        // do not grant the allowance; candidate and interpreter owners cannot.
+        const Il2CppAssembly* owners[] = {PhysicalMethodAssembly(method), PhysicalMethodAssembly(definition)};
+        for (const auto* owner : owners)
+            if (!owner || !owner->aname.name ||
+                configuration->stableByName.Find(owner->aname.name) != owner ||
+                (candidates && candidates->byAssembly.count(owner))) return false;
+        if (method->is_inflated || method->klass->generic_class)
+        {
+            CapturedArgumentFailure failure;
+            CapturedArgumentVisitor visitor(candidates, nullptr, "terminal-fixed-diagnostic", failure);
+            visitor.terminalDiagnostic = true;
+            if (method->is_inflated && (!method->genericMethod || definition == method || definition->is_inflated ||
+                !visitor.Context(method->genericMethod->context, "class_inst", "method_inst"))) return false;
+            if (method->klass->generic_class)
+            {
+                const auto& context = method->klass->generic_class->context;
+                if (!context.class_inst || context.method_inst ||
+                    !visitor.Context(context, "declaring_class_inst", "declaring_method_inst")) return false;
+            }
+        }
+        return true;
+    }
